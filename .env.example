# ─────────────────────────────────────────────────────────────────────────────
# CareerCase — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anonymous/public key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Notes ─────────────────────────────────────────────────────────────────────
# Production AI requests should go through the Cloudflare Worker. Set its
# origin only; the client appends `/ai` when sending requests. Keep Groq
# secrets out of VITE_* variables: browser-exposed variables are public.
# Leave unset when running without the optional AI Worker.
# VITE_AI_PROXY_URL=https://your-worker.workers.dev
# The same Worker origin exposes the trusted /sih/* boundary. No privileged
# Supabase key is ever configured in a VITE_* variable.

# Development-only fallback. Never set this for a production deployment.
# VITE_GROQ_API_KEYS=
#
# Supabase tables required:
#   career_history   – columns: id (uuid pk default gen_random_uuid()),
#                      user_id (uuid references auth.users), job_title (text),
#                      job_data (jsonb), timestamp (int8)
#   career_favorites – columns: id (uuid pk default gen_random_uuid()),
#                      user_id (uuid references auth.users), job_title (text),
#                      job_data (jsonb), saved_at (int8)
#                      unique constraint on (user_id, job_title)
#
# Both tables should have Row Level Security (RLS) enabled with policies that
# allow users to read/write only their own rows (user_id = auth.uid()).
